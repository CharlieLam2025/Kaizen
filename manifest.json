{
  "manifest_version": 3,
  "name": "Kaizen",
  "short_name": "Kaizen",
  "version": "0.7.6",
  "description": "Kaizen — 把 YouTube 和 B 站当书读：双语字幕、划线笔记、生词本，再按知识块拆开。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["sidePanel", "storage", "tabs", "scripting"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtube.com/*",
    "*://youtu.be/*",
    "*://*.youtu.be/*",
    "*://*.youtube-nocookie.com/*",
    "*://*.bilibili.com/*",
    "*://*.hdslb.com/*",
    "https://api.deepseek.com/*",
    "https://api.supadata.ai/*",
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtu.be/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.bilibili.com/*"
      ],
      "js": ["i18n.js", "i18n-dict.js", "site.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Kaizen",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/mark-cat-golden.png", "icons/mark-dog-samoyed.png"],
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtu.be/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.bilibili.com/*"
      ]
    }
  ],
  "commands": {
    "reload-kaizen": {
      "suggested_key": {
        "default": "Alt+R",
        "mac": "Alt+R"
      },
      "description": "重新加载 Kaizen，并刷新已打开的视频页"
    }
  }
}
