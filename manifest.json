{
  "manifest_version": 3,
  "name": "拆砖",
  "short_name": "拆砖",
  "version": "0.5.1",
  "description": "把 YouTube 视频拆成能记住的砖：双语阅读、四色划线、知识块、概念图、复习卡、笔记导出。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["sidePanel", "storage", "tabs", "scripting"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://api.deepseek.com/*",
    "https://api.supadata.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "打开拆砖",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
